# Dependencies / package manager output
node_modules/
.pnpm-store/

# TypeScript / Vite build outputs
packages/*/dist/
packages/*/tsconfig.tsbuildinfo
*.tsbuildinfo

# Electron Forge output
.vite/
out/
dist/

# Native (N-API / cmake-js) addon build artifacts
packages/native-core/build/
packages/native-core/prebuilds/
packages/live-inject/build/
packages/live-inject/agent/build-agent/
*.node
*.dll

# Test output
playwright-report/
test-results/
.nyc_output/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp

# Claude Code local (personal) settings — also ignored globally; listed for clarity
.claude/settings.local.json

# Bulky AI research artifacts — keep the distilled docs/ and the small synthesis,
# NOT the raw 808KB source copy or the multi-MB consult transcripts.
.planning/research/source-transcript.txt
.planning/research/*.out
.planning/research/*.utf8.txt

# Large archives
*.tgz

# Real SWG asset fixtures (local client extracts — never committed; synthetic fixtures are tracked)
# TRE archives
packages/harness/fixtures-real/*.tre
packages/harness/fixtures-real/*.TRE
# Real geometry / texture / shader assets extracted from client TREs (not synthetic)
packages/harness/fixtures-real/mesh/*.msh
packages/harness/fixtures-real/mesh/*.lmg
packages/harness/fixtures-real/mesh/*.mgn
packages/harness/fixtures-real/texture/*.dds
packages/harness/fixtures-real/shader/*.sht
packages/harness/fixtures-real/shader/*.cshd
# Real appearance assets (LOD, appearance templates, skeletons)
packages/harness/fixtures-real/lod/*.lod
packages/harness/fixtures-real/appearance/*.apt
packages/harness/fixtures-real/appearance/*.sat
packages/harness/fixtures-real/skeleton/*.skt
# Real shader-effect assets (04.4-05 — a_envmask_specmap.eft, local-only CORE-05 gate)
packages/harness/fixtures-real/effect/*.eft
# Real DTII datatable asset (05-02 — appearance_table.iff, local-only CORE-05 gate)
packages/harness/fixtures-real/datatable/*.iff
# Real .stf localized-string-table asset (05-05 — aprilfools.stf, local-only CORE-05 gate)
packages/harness/fixtures-real/stf/*.stf

# SWG client crash dumps + boot trace — the client writes these into its working
# directory (which launch-and-inject pointed at the toolkit dir before the 05 cwd
# fix). They are client artifacts, never toolkit files.
SwgClient_r.exe-*.mdmp
SwgClient_r.exe-*.txt
swgclient-boot-trace.log
